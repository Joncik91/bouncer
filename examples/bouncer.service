[Unit]
Description=bouncer — predicate-gated rule injection daemon
After=network.target

[Service]
Type=simple
# Customise these for your install:
WorkingDirectory=/opt/bouncer
Environment=RULES_DIR=/opt/bouncer/rules
Environment=MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
Environment=DEFAULT_THRESHOLD=0.35
Environment=TOP_K=3
ExecStart=/opt/bouncer/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8765 --log-level warning
Restart=always
RestartSec=5
StandardOutput=append:/var/log/bouncer.log
StandardError=append:/var/log/bouncer.log

# Sandboxing — customise these for your install (User/Group and
# ReadWritePaths must match the account and log path you actually use).
# Binding to 127.0.0.1 does not isolate /route from other local users on a
# shared machine; this sandboxing is the actual isolation boundary.
User=bouncer
Group=bouncer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
